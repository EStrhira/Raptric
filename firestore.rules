rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reviews collection rules
    match /reviews/{reviewId} {
      // Public read access for verified reviews
      allow read: if request.auth != null && resource.data.verified == true;
      
      // Allow read for own reviews (even if not verified)
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      
      // Allow create new reviews (any authenticated user)
      allow create: if request.auth != null 
        && request.auth.uid == request.resource.data.userId
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.productType in ['ebike', 'cycle', 'accessory']
        && request.resource.data.title is string
        && request.resource.data.content is string
        && request.resource.data.userName is string
        && request.resource.data.userEmail is string;
      
      // Allow update for own reviews only
      allow update: if request.auth != null 
        && request.auth.uid == resource.data.userId
        && request.resource.data.userId == resource.data.userId; // Can't change author
      
      // Allow delete for own reviews only
      allow delete: if request.auth != null 
        && request.auth.uid == resource.data.userId;
      
      // Admin can do anything (assuming you have an admin role field)
      allow write: if request.auth != null 
        && request.auth.token.admin == true;
    }
    
    // Public read access for product stats (aggregated data)
    match /product-stats/{productId} {
      allow read: if true; // Public read for stats
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Users can read their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
